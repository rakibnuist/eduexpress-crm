# Copy to .env on the VPS (cp .env.example .env) and fill in real values.
# docker-compose.yml reads these.

# Secret that unlocks /api/auth/emergency-reset (leave blank to keep it disabled).
# Generate your own: openssl rand -hex 24
RESET_KEY=

# Stable application/session secret. Generate with: openssl rand -hex 32
JWT_SECRET=

# Service-to-service key used by n8n. Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# HMAC/shared secret expected from the website lead-ingestion service.
WEBSITE_WEBHOOK_SECRET=

# Meta App Secret used to verify X-Hub-Signature-256 webhook signatures.
META_APP_SECRET=

# Optional fallback for the Meta webhook verification challenge.
META_WEBHOOK_VERIFY_TOKEN=

# Optional comma-separated browser origins allowed to call the API cross-origin.
# Same-origin access works when this remains blank.
CORS_ORIGINS=

# Explicit opt-in for legacy lead/page-name cleanup jobs. Keep false unless a
# reviewed backup exists and you intentionally want historical records updated.
RUN_DATA_BACKFILLS=false

# Configure only the provider you use.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENCODE_GO_API_KEY=
LLM_PROVIDER=
LLM_MODEL=

# Required only when using the n8n publishing workflow.
N8N_PUBLISH_WEBHOOK=

# Optional AI welcome-message workflow. Disabled when blank.
N8N_WELCOME_WEBHOOK=
